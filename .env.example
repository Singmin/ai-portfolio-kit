# Optional: both are required to enable model-assisted source selection.
# Keep credentials server-side. Never use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Absolute public origin for canonical URLs and stricter API origin checking.
SITE_URL=http://localhost:3000
# Defaults to .cache in this repository. Must be writable on a persistent disk.
# AI_RATE_LIMIT_DIR=
# Leave false unless your trusted reverse proxy OVERWRITES x-forwarded-for.
TRUST_PROXY=false
